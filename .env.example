# Google Gemini API key — free tier at https://aistudio.google.com/apikey
# Server-side only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: override the model (default: gemini-flash-latest, falls back to gemini-3.5-flash-lite
# when the primary is rate-limited or unavailable)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: return canned responses instead of calling the AI (for UI work without a key)
# LLM_MOCK=true
